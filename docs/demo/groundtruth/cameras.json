    "azimuth": "0 = the main photo's viewpoint (camera on +z). Positive azimuth moves the camera towards +x (the photo's right-hand side), i.e. counter-clockwise seen from above; 90 looks at the object's +x side, 180 at its back, 270 at its -x side.",
    "position": "target + distance * [cos(el) * sin(az), sin(el), cos(el) * cos(az)]"
  },
  "image": {
    "width": 640,
    "height": 640,
    "format": "png",
    "background": "#2a2f38",
    "file": "<id>-az<deg>.png"
  },
  "rendering": {
