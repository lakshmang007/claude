# Copy to .env and fill in.

# Your domain name. Its DNS "A" record must point to this server's IP address.
DOMAIN=runpad.example.com

# Shown on the home page so people can report abuse (an e-mail address or a URL).
RUNPAD_CONTACT=you@example.com

# Opens every pad and lock, so you can remove abuse. Make one with: openssl rand -hex 24
RUNPAD_ADMIN_TOKEN=

# Optional: a key people must enter once before they can run code. Leave empty to let
# everyone run code.
RUNPAD_EXEC_TOKEN=

# Sizing. Defaults suit a server with 2 CPUs and 4 GB of memory.
RUNPAD_CPUS=2
RUNPAD_MEMORY=2g
RUNPAD_MAX_CONCURRENT=6
RUNPAD_WORK_SIZE=1g
RUNPAD_MAX_STORAGE_MB=2048
